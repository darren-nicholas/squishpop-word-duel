{
  "name": "squishpop-word-duel",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/fredoka": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "an-array-of-english-words": "^2.0.0",
    "expo": "~57.0.26",
    "expo-font": "^57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linear-gradient": "^57.0.2",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.2",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.2",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:images",
    "build:check": "expo export --platform ios --platform android --max-workers 2",
    "test:images": "python3 -m unittest discover -s tests -p 'test_*.py'"
  },
  "private": true,
  "overrides": {
